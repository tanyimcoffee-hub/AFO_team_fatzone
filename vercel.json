{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{data/places/**,places_bkk_cnx.json,ai-engine/system-prompt.md}"
